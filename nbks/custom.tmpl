<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="./data/favicon.ico">
    <style type="text/css">
      /* CLEANUP NOTES (see backup/custom.tmpl.bak for the original)
         - Colours now come from the kit's theme variables (--theme-background,
           --theme-foreground), set once on body below. Notebook theme changed
           from "air" (light) to "midnight" (dark) in index.html so the kit's
           dark colour-scheme matches the black page.
         - Font comes from the kit's --serif variable, which names the web font
           correctly ("Source Serif 4 Variable"). Only the serif is imported now.
         - Removed: vendor-prefixed transitions/user-select, duplicate viewport
           meta, duplicate html/body blocks, invalid "margin: none", the
           "* { margin-top: 0 !important }" hammer, the box-sizing reset,
           #observablehq-main (no such element), and unused rules (.clmleft,
           .clmright, .glow, .none, img, img.zi, #byline:after float clear,
           commented-out blocks, --bkgnd-darkblue).
      */
      @import url("observable:styles/index.css");
      @import url("@fontsource-variable/source-serif-4/opsz.css");
      @import url("@fontsource-variable/source-serif-4/opsz-italic.css");

      /* neutralise the kit's page chrome (body margin/padding, <main> max-width) */
      html, body {
        margin: 0;
        padding: 0;
      }
      body {
        /* override the kit's theme colours once; everything below uses them.
           Set on body, not :root: the theme stylesheet is injected after this
           one and would win a same-specificity :root override. */
        --theme-background: black;
        --theme-foreground: floralwhite;
        cursor: none;
      }
      main {
        margin: 0;
        max-width: none;
      }

      #field {
        position: absolute;
        top: 7vw;
        /* centred on the extent of its spels; see centerField in scoringthespeltair */
        left: calc((100% - var(--extent-w, 0vw)) / 2 - var(--extent-x, 0vw));
        font-family: var(--serif);
        font-size: 2.5vw;
        font-variant-ligatures: no-common-ligatures;
        font-variation-settings: "wght" 300;
        line-height: 1.8;
        user-select: none;
        -webkit-user-select: none; /* Safari */
        transition: opacity 2.5s ease-in-out;
      }

      #byline {
        color: var(--theme-foreground);
        font-size: 1.6vw;
        line-height: 1.1;
        padding: 0 10vw 2vw;
        text-align: center;
        z-index: 10;
        cursor: pointer;
        opacity: 0;
        transition: opacity .7s ease-in-out;
      }

      #byline:hover {
        opacity: 1;
      }

      #byline a {
        color: var(--theme-foreground);
        text-decoration: none;
      }

      #byline a:hover {
        color: lightgray;
      }

      .char {
        opacity: 0;
        transition: all 1.3s ease-in-out;
      }

      .char.visible {
        opacity: 1;
      }

      .spel {
        position: absolute;
        opacity: 0;
        transition: all 1.5s ease-in-out;
      }

      .spel.visible {
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <main></main>
  </body>
</html>
